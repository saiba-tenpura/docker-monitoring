route:
  group_by: ['instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: telegram-bot

receivers:
  - name: telegram-bot
    telegram_configs:
      - bot_token: $TELEGRAM_BOT_TOKEN
        chat_id: $TELEGRAM_CHAT_ID
        message: '{{ template "telegram.custom.message" . }}'

templates:
  - '/etc/alertmanager/telegram.tmpl'

inhibit_rules:
  # Suppress warnings when a critical is firing for the same instance
  - source_matchers:
      - severity = "critical"
    target_matches:
      - severity = "warning"
    equal:
      - alertname
      - instance

  - source_matchers:
      - alertname = "InstanceDown"
    target_matchers:
      - job = "prometheus"
    equal:
      - instance
