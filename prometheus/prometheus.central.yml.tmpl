global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - alert.rules

scrape_configs:
  - job_name: prometheus
    metric_relabel_configs:
      - replacement: pitsu
        target_label: 'instance'
    static_configs:
      - targets:
        - localhost:9090

  - job_name: node-exporter
    metric_relabel_configs:
      - replacement: pitsu
        target_label: 'instance'
    static_configs:
      - targets:
        - node-exporter:9100

  - job_name: cadvisor
    metric_relabel_configs:
      - replacement: pitsu
        target_label: 'instance'
    static_configs:
      - targets:
        - cadvisor:8080

  - job_name: traefik
    metric_relabel_configs:
      - replacement: pitsu
        target_label: 'instance'
    static_configs:
      - targets:
        - traefik-proxy:8080

  - job_name: federate
    basic_auth:
      username: prometheus
      password: $PROMETHEUS_PASSWORD
    scheme: https
    honor_labels: true
    metrics_path: '/federate'
    params:
      'match[]':
        - '{__name__=~".+"}'
    metric_relabel_configs:
      - source_labels: ['monitor']
        target_label: instance
      - action: labeldrop
        regex: monitor
    static_configs:
      - targets:
        - 'prometheus.saiba-tenpura.com'

alerting:
  alertmanagers:
    - static_configs:
      - targets:
        - alertmanager:9093
