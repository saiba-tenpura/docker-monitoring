global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - base.rules

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
        - localhost:9090

  - job_name: node-exporter
    static_configs:
      - targets:
        - node-exporter:9100

  - job_name: cadvisor
    static_configs:
      - targets:
        - cadvisor:8080

  - job_name: traefik
    static_configs:
      - targets:
        - traefik-proxy:8080

  - job_name: federate
    basic_auth:
      username: prometheus
      password: $PROMETHEUS_PASSWORD
    honor_labels: true
    metrics_path: '/federate'
    params:
      'match[]':
        - '{__name__=~".+"}'
    static_configs:
      - targets:
        - 'prometheus.saiba-tenpura.com:443'

alerting:
  alertmanagers:
    - static_configs:
      - targets:
        - alertmanager:9093
