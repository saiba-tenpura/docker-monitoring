global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - alert.rules

scrape_configs:
  - job_name: prometheus
    metric_relabel_configs:
      - replacement: pitsu
        target_label: 'instance'
    static_configs:
      - targets:
        - localhost:9090

  - job_name: node-exporter
    metric_relabel_configs:
      - replacement: pitsu
        target_label: 'instance'
    static_configs:
      - targets:
        - node-exporter:9100

  - job_name: cadvisor
    metric_relabel_configs:
      - replacement: pitsu
        target_label: 'instance'
    static_configs:
      - targets:
        - cadvisor:8080

  - job_name: traefik
    metric_relabel_configs:
      - replacement: pitsu
        target_label: 'instance'
    static_configs:
      - targets:
        - traefik-proxy:8080

  - job_name: blackbox-http
    scrape_interval: 25s
    scrape_timeout: 20s
    metrics_path: /probe
    params:
      module: [http_2xx]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
    static_configs:
      - targets:
        - http://saiba-tenpura.com
//        - http://static.saiba-tenpura.com

  - job_name: blackbox-smtp
    metrics_path: /probe
    params:
      module: [smtp_starttls]
    relabel_configs:
      - source_labels: [__address__]
        regex: (.*)(:.*)?
        replacement: ${1}:587
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
    static_configs:
      - targets:
        - 'mail.saiba-tenpura.com'

  - job_name: blackbox-exporter
    static_configs:
      - targets:
        - blackbox-exporter:9115

  - job_name: federate
    basic_auth:
      username: prometheus
      password: $PROMETHEUS_PASSWORD
    scheme: https
    scrape_interval: 25s
    scrape_timeout: 20s
    honor_labels: true
    metrics_path: '/federate'
    params:
      'match[]':
        - '{__name__=~".+"}'
    metric_relabel_configs:
      - source_labels: ['monitor']
        target_label: instance
      - action: labeldrop
        regex: monitor
    static_configs:
      - targets:
        - 'prometheus.saiba-tenpura.com'
        - 'prometheus-kiessling.saiba-tenpura.com'

alerting:
  alertmanagers:
    - static_configs:
      - targets:
        - alertmanager:9093
